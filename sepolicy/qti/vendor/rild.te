type rild_data_dir;
type rild_data_file;
type rild_cache_file;


allow rild mnt_vendor_file:dir search;

allow rild vendor_proc_display:file r_file_perms;
# Allow rild to read, write and create files in vendor_data_file
allow rild vendor_data_file:dir rw_dir_perms;
allow rild vendor_data_file:file create_file_perms;

# Allow access to /data/opponvitems
allow rild system_data_root_file:dir rw_file_perms;
allow rild system_data_root_file:file rw_dir_perms;

# Allow access to /cache
allow rild rild_cache_file:dir { search getattr };

r_dir_file(rild, vendor_proc_engineer)

set_prop(rild, vendor_nw_exported_system_prop)
get_prop(rild, default_prop)
get_prop(rild, system_prop)
